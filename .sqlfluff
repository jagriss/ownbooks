[sqlfluff]
dialect = duckdb
templater = jinja
max_line_length = 80
# Surrogate/primary keys are placed first by convention in these
# models, ahead of the wildcards-then-simple-then-calculated ordering
# structure.column_order otherwise enforces.
exclude_rules = structure.column_order

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

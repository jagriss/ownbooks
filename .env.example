# Copy to .env and edit only when overriding the pixi defaults.
#
# scripts/activate-env.sh defaults these to paths under data/, so a
# local checkout needs no .env at all. A variable set in the shell
# (FINANCE_DUCKDB_PATH=... pixi run app) also overrides the default.

# Local DuckDB warehouse file.
# FINANCE_DUCKDB_PATH=/absolute/path/to/data/finance.duckdb

# Root folder of bank CSV exports. One subfolder per account, named
# with the account_key from transform/seeds/accounts.csv:
#   data/statements/chase_checking/*.csv
# FINANCE_STATEMENTS_ROOT=/absolute/path/to/data/statements
